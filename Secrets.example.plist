<?xml version="1.0" encoding="UTF-8"?>
<!--
  LYFESTYL — Secrets template.

  SETUP (one time):
    1. Copy this file to  LYFESTYLE/Secrets.plist   (note the subfolder).
       cp Secrets.example.plist LYFESTYLE/Secrets.plist
    2. Paste your Supabase Project URL and your PUBLISHABLE key below.
       Find them in the Supabase dashboard → Project Settings → API.
    3. LYFESTYLE/Secrets.plist is gitignored, so your keys never get committed.

  NOTES:
    • Use the PUBLISHABLE key (starts with "sb_publishable_") — it is the safe,
      client-side key. It is fine to ship inside the app; Row Level Security on
      the database is what actually protects user data.
    • NEVER put the SECRET key (starts with "sb_secret_") in the app. It is a
      server-only admin key. The app does not use it.
    • Foundation Models (the on-device AI) needs NO key.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>https://YOUR-PROJECT-REF.supabase.co</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>sb_publishable_REPLACE_ME</string>
</dict>
</plist>
